{
  "name": "thunderbird-closetobackground",
  "version": "0.1.6",
  "private": true,
  "description": "Linux-first Thunderbird close-to-tray add-on and native helper",
  "scripts": {
    "build": "python3 scripts/build.py",
    "test": "node tests/run.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:dbus": "dbus-run-session -- python3 tests/dbus_integration.py",
    "test:packages": "python3 tests/package_lifecycle.py",
    "test:policies": "dbus-run-session -- xvfb-run -a python3 tests/policy_integration.py",
    "test:thunderbird": "dbus-run-session -- xvfb-run -a python3 tests/thunderbird_integration.py",
    "test:gnome": "dbus-run-session -- python3 tests/gnome_integration.py"
  },
  "engines": {"node": ">=18"}
}
